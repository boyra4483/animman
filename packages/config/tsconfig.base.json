{
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@animman/tma/*": ["../../apps/tma/src/*"],
			"@animman/server/*": ["../../apps/server/src/*"],
			"@animman/bot/*": ["../../apps/bot/src/*"],
			"@animman/config/*": ["../../packages/config/src/*"],
			"@animman/shared/*": ["../../packages/shared/src/*"]
		},
		"noImplicitAny": true,
		"jsx": "react-jsx",
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	}
}
